<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_floating_bubble"
    android:padding="6dp"
    android:gravity="center_vertical"
    android:elevation="10dp">

    <!-- Botón Principal Play / Pausa que alterna icono y acción -->
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/btn_circle_ripple"
        android:src="@drawable/ic_play"
        android:tint="#FFFFFF"
        android:scaleType="centerInside"
        android:contentDescription="Play/Pausa" />

    <!-- Botón pequeño para cerrar el widget -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#CCCCCC"
        android:contentDescription="Cerrar" />

</LinearLayout>